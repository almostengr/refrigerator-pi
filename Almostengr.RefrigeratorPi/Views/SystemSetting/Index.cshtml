@using Almostengr.RefrigeratorPi.Features.Common.Shared
@using Almostengr.RefrigeratorPi.Features.SystemSettings.Domain
@model List<SystemSettingEntity>

<h1>System Settings</h1>
<div class="row fw-bold">
    <div class="col">Name</div>
    <div class="col">Value</div>
    <div class="col">Modified</div>
</div>
@foreach (var item in Model)
{
    <div class="row border-1 border-top my-1 py-1">
        <div class="col">
            <a href="#" class="genericModal" data-url="/systemsetting/edit/@item.Id">@item.SettingOption.ToDescription()</a>
        </div>
        <div class="col">@item.Value</div>
        <div class="col">
            @item.ModifiedDate.ToShortDateString()
            @item.ModifiedDate.ToShortTimeString()
        </div>
    </div>
}