@using Almostengr.RefrigeratorPi.Features.Common.Shared
@model HomePageViewModel

<div class="row row-cols-1 row-cols-md-2 mb-3 text-center">
    <div class="col">
        <div class="card mb-4 rounded-3 shadow-sm">
            <div class="card-header py-3">
                <h4 class="my-0 fw-normal">Temperature</h4>
            </div>
            <div class="card-body">
                <h1 class="card-title pricing-card-title">
                    @Model.Temperatures.FirstOrDefault().ReadingC C
                </h1>
                <ul class="list-unstyled mt-3 mb-4">
                    <li>Cooling: @Model.IsCompressorRunning.ToOnOff()</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card mb-4 rounded-3 shadow-sm">
            <div class="card-header py-3">
                <h4 class="my-0 fw-normal">Latest Readings</h4>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mt-3 mb-4">
                    @foreach (var temperature in Model.Temperatures)
                    {
                        <li>@temperature.ReadingC</li>
                    }
                </ul>
                <button type="button" class="w-100 btn btn-lg btn-primary">See Details</button>
            </div>
        </div>
    </div>
</div>