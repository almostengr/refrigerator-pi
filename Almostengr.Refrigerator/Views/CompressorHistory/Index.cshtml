@using Almostengr.Refrigerator.Features.Compressors.DomainServices.Resources
@model List<CompressorHistoryResource>

<h1>Compressor History</h1>
<div class="row fw-bold">
    <div class="col">Start Time</div>
    <div class="col">Stop Time</div>
    <div class="col">Duration</div>
</div>
@foreach (var item in Model)
{
    <div class="row border-1 border-top my-1 py-1">
        <div class="col">
            @item.StartDate.ToShortDateString()
            @item.StartDate.ToShortTimeString()
        </div>
        <div class="col">
            @if (item.EndDate.HasValue)
            {
                @item.EndDate.Value.ToShortDateString()
                @item.EndDate.Value.ToShortTimeString()
            }
        </div>
        <div class="col">
            @if (item.Duration.HasValue)
            {
                @item.Duration.Value.ToString()
            }
        </div>
    </div>
}